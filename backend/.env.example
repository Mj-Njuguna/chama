# Copy to backend/.env for local overrides. Never commit .env. Defaults live in compose.yaml.
# Production values come from the deployment's secret manager, not from a file in the repo.

# DJANGO_SECRET_KEY=            # required in prod (50+ chars); dev has a local-only default
# DJANGO_ALLOWED_HOSTS=         # comma-separated; required in prod
# DJANGO_SETTINGS_MODULE=config.settings.dev

# POSTGRES_DB=chama
# Local Postgres roles. The app connects as app_rw; migrations run as app_owner; the superuser
# only creates those two roles (just db-roles).
# POSTGRES_SUPERUSER=chama
# POSTGRES_SUPERUSER_PASSWORD=chama-local-only
# APP_OWNER_PASSWORD=app-owner-local-only
# APP_RW_PASSWORD=app-rw-local-only

# LOG_LEVEL=INFO
# LOG_FORMAT=json               # json | console (readable local output)

# Host ports (change if something else already uses them)
# APP_PORT=8001
# DB_PORT=5433
# REDIS_PORT=6380

# Key rings: "id:base64url,..." newest first. Dev uses fixed non-secret defaults; prod refuses to
# start without them.
# AUDIT_HASH_KEYS=
# OTP_PEPPER_KEYS=
# AUTH_TOKEN_KEYS=
# PIN_PEPPER_KEYS=
# FIELD_ENCRYPTION_KEYS=

# Proxies in front of the app appending X-Forwarded-For. Required in prod.
# TRUSTED_PROXY_COUNT=0
