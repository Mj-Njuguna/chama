{
  "name": "chama-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "gen:api": "openapi-typescript ../backend/openapi/schema.yaml -o src/api/generated/schema.d.ts",
    "check:api": "npm run gen:api && npm run gen:api:draft && git diff --exit-code -- src/api/generated",
    "gen:api:draft": "openapi-typescript src/api/draft/m2.openapi.yaml -o src/api/generated/draft-m2.d.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ],
    "clearMocks": true,
    "testTimeout": 15000
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.26",
    "expo-asset": "58.0.21",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-local-authentication": "58.0.3",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "libphonenumber-js": "1.13.17",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
